[
 {
  "key": "l001",
  "scene": "intro",
  "text": "这是我自己做的录屏软件，",
  "dur": 1.487
 },
 {
  "key": "l002",
  "scene": "intro",
  "text": "Mac 和 Windows 都能用。",
  "dur": 1.7
 },
 {
  "key": "l003",
  "scene": "intro",
  "text": "下面带你从头到尾看一遍。",
  "dur": 1.81
 },
 {
  "key": "l004",
  "scene": "main",
  "text": "打开它，先选要录什么：",
  "dur": 1.852
 },
 {
  "key": "l005",
  "scene": "main",
  "text": "整个屏幕，或者某一个窗口。",
  "dur": 2.099
 },
 {
  "key": "l006",
  "scene": "main",
  "text": "只想录一小块？点「选区域」，",
  "dur": 2.564
 },
 {
  "key": "l007",
  "scene": "picker",
  "text": "把要录的地方框出来就行。",
  "dur": 1.592
 },
 {
  "key": "l008",
  "scene": "opts",
  "text": "电脑里的声音、你说的话，",
  "dur": 2.192
 },
 {
  "key": "l009",
  "scene": "opts",
  "text": "都可以勾上，一起录下来。",
  "dur": 1.733
 },
 {
  "key": "l010",
  "scene": "opts",
  "text": "打开摄像头，你会出现在角落。",
  "dur": 2.432
 },
 {
  "key": "l011",
  "scene": "opts",
  "text": "倒计时，给你几秒准备；",
  "dur": 2.025
 },
 {
  "key": "l012",
  "scene": "opts",
  "text": "隐藏桌面图标，画面更干净；",
  "dur": 2.419
 },
 {
  "key": "l013",
  "scene": "opts",
  "text": "开勿扰，录的时候不弹消息。",
  "dur": 2.257
 },
 {
  "key": "l014",
  "scene": "opts",
  "text": "点「开始录制」，或者按快捷键。",
  "dur": 2.414
 },
 {
  "key": "l015",
  "scene": "count",
  "text": "倒数三秒，就开始录了。",
  "dur": 2.066
 },
 {
  "key": "l016",
  "scene": "count",
  "text": "录完再按一次，就停下来。",
  "dur": 1.994
 },
 {
  "key": "l017",
  "scene": "studio",
  "text": "最特别的是「Studio 效果」。",
  "dur": 1.958
 },
 {
  "key": "l018",
  "scene": "studio",
  "text": "左边是原样录下来的，",
  "dur": 1.465
 },
 {
  "key": "l019",
  "scene": "studio",
  "text": "右边是打开它以后的成片。",
  "dur": 1.636
 },
 {
  "key": "l020",
  "scene": "studio",
  "text": "你点到哪里，镜头就自动凑过去，",
  "dur": 2.688
 },
 {
  "key": "l021",
  "scene": "studio",
  "text": "鼠标走得更顺，点一下还有小波纹。",
  "dur": 2.848
 },
 {
  "key": "l022",
  "scene": "ov",
  "text": "录完，会打开剪辑窗口。",
  "dur": 2.012
 },
 {
  "key": "l023",
  "scene": "ov",
  "text": "上面是预览，就是成片的样子；",
  "dur": 2.311
 },
 {
  "key": "l024",
  "scene": "ov",
  "text": "下面是时间轴，从头到尾；",
  "dur": 2.256
 },
 {
  "key": "l025",
  "scene": "ov",
  "text": "右边，是调样式的地方。",
  "dur": 2.145
 },
 {
  "key": "l026",
  "scene": "zoom",
  "text": "紫色的块，表示这段时间镜头凑近。",
  "dur": 3.288
 },
 {
  "key": "l027",
  "scene": "zoom",
  "text": "拖它的一头，可以改长短；",
  "dur": 2.114
 },
 {
  "key": "l028",
  "scene": "zoom",
  "text": "拖中间，可以挪位置；",
  "dur": 1.582
 },
 {
  "key": "l029",
  "scene": "zoom",
  "text": "空白处双击，就多加一段；",
  "dur": 2.271
 },
 {
  "key": "l030",
  "scene": "zoom",
  "text": "选中按删除，就去掉了。",
  "dur": 2.187
 },
 {
  "key": "l031",
  "scene": "zoom",
  "text": "拖这个滑块，调放大几倍；",
  "dur": 2.359
 },
 {
  "key": "l032",
  "scene": "zoom",
  "text": "也可以选「固定位置」，",
  "dur": 1.231
 },
 {
  "key": "l033",
  "scene": "zoom",
  "text": "让镜头一直盯着一个地方。",
  "dur": 1.909
 },
 {
  "key": "l034",
  "scene": "zoom",
  "text": "推近的快慢，也能调。",
  "dur": 1.98
 },
 {
  "key": "l035",
  "scene": "cut",
  "text": "开头结尾不想要，拖黄色括号。",
  "dur": 2.487
 },
 {
  "key": "l036",
  "scene": "cut",
  "text": "中间有一段不要？点「剪掉」，",
  "dur": 2.517
 },
 {
  "key": "l037",
  "scene": "cut",
  "text": "红色的这段，成片里就没有了。",
  "dur": 2.724
 },
 {
  "key": "l038",
  "scene": "cut",
  "text": "等加载、打字这种无聊的地方，",
  "dur": 2.53
 },
 {
  "key": "l039",
  "scene": "cut",
  "text": "可以改成加速，最快八倍。",
  "dur": 1.996
 },
 {
  "key": "l040",
  "scene": "cut",
  "text": "点这个按钮，它会自动找出",
  "dur": 2.446
 },
 {
  "key": "l041",
  "scene": "cut",
  "text": "可以快进的地方，一点就采纳。",
  "dur": 2.332
 },
 {
  "key": "l042",
  "scene": "sound",
  "text": "声音也能分开调：",
  "dur": 1.212
 },
 {
  "key": "l043",
  "scene": "sound",
  "text": "电脑声音、麦克风，各调各的。",
  "dur": 2.698
 },
 {
  "key": "l044",
  "scene": "sound",
  "text": "有杂音？打开降噪，",
  "dur": 2.158
 },
 {
  "key": "l045",
  "scene": "sound",
  "text": "风扇声、键盘声就小了。",
  "dur": 2.197
 },
 {
  "key": "l046",
  "scene": "sound",
  "text": "录完还想补几句讲解，",
  "dur": 1.393
 },
 {
  "key": "l047",
  "scene": "sound",
  "text": "点「录讲解」，边看边说，",
  "dur": 1.923
 },
 {
  "key": "l048",
  "scene": "sound",
  "text": "讲解会变成绿色的一段。",
  "dur": 1.544
 },
 {
  "key": "l049",
  "scene": "sound",
  "text": "还能加背景音乐，",
  "dur": 1.145
 },
 {
  "key": "l050",
  "scene": "sound",
  "text": "你说话的时候，音乐会自动变小。",
  "dur": 2.535
 },
 {
  "key": "l051",
  "scene": "caption",
  "text": "想加字幕？点「字幕」，",
  "dur": 2.334
 },
 {
  "key": "l052",
  "scene": "caption",
  "text": "说的话会自动变成文字。",
  "dur": 2.08
 },
 {
  "key": "l053",
  "scene": "caption",
  "text": "一次只出一行，",
  "dur": 1.055
 },
 {
  "key": "l054",
  "scene": "caption",
  "text": "错字双击就能改，样式也能调。",
  "dur": 2.781
 },
 {
  "key": "l055",
  "scene": "style",
  "text": "右边的样式，最省事是选预设。",
  "dur": 2.751
 },
 {
  "key": "l056",
  "scene": "style",
  "text": "比如「抖音竖屏」，一下就变竖了。",
  "dur": 2.544
 },
 {
  "key": "l057",
  "scene": "style",
  "text": "方形也行。",
  "dur": 0.668
 },
 {
  "key": "l058",
  "scene": "style",
  "text": "背景能换纯色、壁纸，",
  "dur": 2.133
 },
 {
  "key": "l059",
  "scene": "style",
  "text": "边距、圆角、阴影也能调。",
  "dur": 2.689
 },
 {
  "key": "l060",
  "scene": "style",
  "text": "鼠标能放大，不动时自动藏起来，",
  "dur": 2.745
 },
 {
  "key": "l061",
  "scene": "style",
  "text": "点击还能配个声音，",
  "dur": 1.219
 },
 {
  "key": "l062",
  "scene": "style",
  "text": "结尾鼠标还会回到起点。",
  "dur": 1.727
 },
 {
  "key": "l063",
  "scene": "style",
  "text": "再打开运动模糊，",
  "dur": 1.082
 },
 {
  "key": "l064",
  "scene": "blur",
  "text": "镜头快速移动时，会带一点拖影，",
  "dur": 2.486
 },
 {
  "key": "l065",
  "scene": "blur",
  "text": "看着更顺，停下来字还是清楚的。",
  "dur": 2.571
 },
 {
  "key": "l066",
  "scene": "mark",
  "text": "录到了手机号、聊天记录？",
  "dur": 1.997
 },
 {
  "key": "l067",
  "scene": "mark",
  "text": "用「遮挡」框起来，",
  "dur": 1.147
 },
 {
  "key": "l068",
  "scene": "mark",
  "text": "模糊或者马赛克都行。",
  "dur": 1.638
 },
 {
  "key": "l069",
  "scene": "mark",
  "text": "想强调哪里，",
  "dur": 0.881
 },
 {
  "key": "l070",
  "scene": "mark",
  "text": "加个箭头、框框，或者一行字。",
  "dur": 3.016
 },
 {
  "key": "l071",
  "scene": "mark",
  "text": "按过的快捷键，",
  "dur": 1.056
 },
 {
  "key": "l072",
  "scene": "mark",
  "text": "也能显示在画面角落。",
  "dur": 1.425
 },
 {
  "key": "l073",
  "scene": "cam",
  "text": "摄像头的画面，可以是小窗，",
  "dur": 2.326
 },
 {
  "key": "l074",
  "scene": "cam",
  "text": "也可以分屏，或者全屏。",
  "dur": 1.981
 },
 {
  "key": "l075",
  "scene": "export",
  "text": "都调好了，点「导出」。",
  "dur": 1.555
 },
 {
  "key": "l076",
  "scene": "export",
  "text": "清晰度、帧数、画质都能选，",
  "dur": 2.821
 },
 {
  "key": "l077",
  "scene": "export",
  "text": "发微信、抖音，1080p 就够了。",
  "dur": 2.983
 },
 {
  "key": "l078",
  "scene": "export",
  "text": "还能导出成动图。",
  "dur": 1.202
 },
 {
  "key": "l079",
  "scene": "export",
  "text": "导出时随时能取消；",
  "dur": 1.612
 },
 {
  "key": "l080",
  "scene": "export",
  "text": "勾上「复制到剪贴板」，",
  "dur": 1.324
 },
 {
  "key": "l081",
  "scene": "export",
  "text": "导完直接去聊天里粘贴。",
  "dur": 1.64
 },
 {
  "key": "l082",
  "scene": "show",
  "text": "同一段录屏，能出横屏，",
  "dur": 2.165
 },
 {
  "key": "l083",
  "scene": "show",
  "text": "也能出竖屏。",
  "dur": 0.896
 },
 {
  "key": "l084",
  "scene": "recent",
  "text": "以前录的，",
  "dur": 0.652
 },
 {
  "key": "l085",
  "scene": "recent",
  "text": "在主窗口下面都能找到，",
  "dur": 1.706
 },
 {
  "key": "l086",
  "scene": "recent",
  "text": "点一下，就能接着剪。",
  "dur": 1.882
 },
 {
  "key": "l087",
  "scene": "recent",
  "text": "把素材拖到程序坞的图标上，",
  "dur": 2.021
 },
 {
  "key": "l088",
  "scene": "recent",
  "text": "也能打开。",
  "dur": 0.694
 },
 {
  "key": "l089",
  "scene": "win",
  "text": "Windows 上也一样好用。",
  "dur": 1.631
 },
 {
  "key": "l090",
  "scene": "win",
  "text": "按 Ctrl+Alt+X，框一块截图，",
  "dur": 3.182
 },
 {
  "key": "l091",
  "scene": "win",
  "text": "截好的图出现在右下角，",
  "dur": 2.086
 },
 {
  "key": "l092",
  "scene": "win",
  "text": "直接拖进聊天窗口，就发出去了。",
  "dur": 2.741
 },
 {
  "key": "l093",
  "scene": "update",
  "text": "有新版本，它会在后台自己下载，",
  "dur": 2.626
 },
 {
  "key": "l094",
  "scene": "update",
  "text": "退出时悄悄换上，你不用管。",
  "dur": 2.569
 },
 {
  "key": "l095",
  "scene": "outro",
  "text": "这就是我做的录屏软件。",
  "dur": 1.573
 },
 {
  "key": "l096",
  "scene": "outro",
  "text": "录完，就是成片。",
  "dur": 1.604
 }
]