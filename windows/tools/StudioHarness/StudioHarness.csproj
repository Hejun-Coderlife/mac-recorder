<Project Sdk="Microsoft.NET.Sdk">
  <!-- 在 Mac / Linux 上用 .NET 8 跑 Studio 合成（StudioCore.cs），对着真素材调效果和速度；不进安装包 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../StudioCore.cs" />
    <Compile Include="../../StudioModel.cs" />
    <Compile Include="../../StudioTests.cs" />
    <Compile Include="../../StudioVoice.cs" />
    <Compile Include="../../StudioTestsW2.cs" />
    <Compile Include="../../Whisper.cs" />
    <Compile Include="../../StudioCanvas.cs" />
    <Compile Include="../../StudioTestsW3.cs" />
    <Compile Include="../../StudioOverlay.cs" />
    <Compile Include="../../StudioMusic.cs" />
    <Compile Include="../../StudioSuggest.cs" />
    <Compile Include="../../StudioTestsW4.cs" />
    <Compile Include="../../StudioPieces.cs" />
    <Compile Include="../../StudioTestsW5.cs" />
  </ItemGroup>
</Project>
