<Project Sdk="Microsoft.NET.Sdk">
  <!-- 录制引擎 ScreenRecorderLib 是 .NET Framework 4.8 的 C++/CLI 程序集，.NET 8 加载不了，所以用 Windows 10/11 自带的 .NET Framework 4.8 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ScreenRecorder</AssemblyName>
    <RootNamespace>ScreenRecorder</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>录屏 Screen Recorder</Product>
    <AssemblyTitle>录屏 Screen Recorder</AssemblyTitle>
    <Version>1.5.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <!-- Studio 合成用显卡（D3D11），见 StudioGpu.cs；这些 dll 和录制引擎一样嵌进 exe -->
    <PackageReference Include="Vortice.Direct3D11" Version="2.4.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="2.4.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- 单个 exe：CI 先编一次拿到 ScreenRecorderLib.dll，把它、VC++ dll、ffmpeg.exe 压成 embed\*.gz 再编一次嵌进来（见 Runtime.cs） -->
    <EmbeddedResource Include="embed\*.gz" LogicalName="rt/%(Filename)%(Extension)" />
    <!-- tools/ 里是在 Mac 上跑合成用的 .NET 8 小工具，不编进程序 -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <!-- .NET Framework 直接引用 WinForms，不走 WindowsDesktop SDK（Mac 上也能编译） -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- 自动更新解压 zip 用 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
