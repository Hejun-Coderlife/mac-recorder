<Project Sdk="Microsoft.NET.Sdk">
  <!-- 录制引擎 ScreenRecorderLib 是 .NET Framework 4.8 的 C++/CLI 程序集，.NET 8 加载不了，所以用 Windows 10/11 自带的 .NET Framework 4.8 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ScreenRecorder</AssemblyName>
    <RootNamespace>ScreenRecorder</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>录屏 Screen Recorder</Product>
    <AssemblyTitle>录屏 Screen Recorder</AssemblyTitle>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- tools/ 里是在 Mac 上跑合成用的 .NET 8 小工具，不编进程序 -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <!-- .NET Framework 直接引用 WinForms，不走 WindowsDesktop SDK（Mac 上也能编译） -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
